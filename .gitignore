# --- Python básico ---
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Entornos virtuales
.venv/
.venv-*/
venv/
.venv-directml/

# Archivos de entorno
.env
*.env

# --- Editor / IDE ---
.vscode/
.idea/

# # --- Datos pesados de entrada (no versionar) ---
# # Imágenes originales y CSV de anotaciones
data/imagenes/
data/csvs/

# Otros datasets antiguos si no los quieres en el repo
data/

# --- Datasets generados por el script de parches ---
datasets/
results/

# --- Modelos entrenados y artefactos grandes ---
*.pt          # Pesos de PyTorch
*.pth
*.onnx
*.h5

# Zips u otros paquetes grandes
*.zip

# Métricas y reportes generados (opcional)
metrics.csv
test_report.txt

# Archivos temporales / sistema
.DS_Store
Thumbs.db
*.swp
*.tmp

# --- Claude Code / Graphify ---
# Configuración local con posibles rutas/tokens específicos de tu máquina
.claude/settings.local.json

# Historial y sesiones locales de Claude Code (si aplica)
.claude/history/

# --- Graphify: todo su output es local y regenerable (graphify update .) ---
# "**/" para que aplique a cualquier graphify-out/, no solo al de la raíz
# (p.ej. scripts/graphify-out/, que puede aparecer si graphify se corre
# por accidente con otro cwd).
**/graphify-out/

# Logs generados durante ejecución (Claude Code o scripts)
*.log
logs/

# API keys sueltas en caso de que las guardes en archivo aparte
**/api_key*
**/*_key.txt
# Informes técnicos generados para la redacción de la tesis (se mantienen locales)
INFORME_*.md
